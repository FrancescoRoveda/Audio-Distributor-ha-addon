#!/usr/bin/with-contenv bashio
# ==============================================================================
# Audio Distributor - Discovery diagnostics finish handler
# ==============================================================================

readonly EXIT_CODE=${1}

if [[ "${EXIT_CODE}" -ne 0 ]] && [[ "${EXIT_CODE}" -ne 256 ]]; then
    bashio::log.error "[discovery-monitor] Crashed with exit code ${EXIT_CODE}"
else
    bashio::log.info "[discovery-monitor] Service stopped"
fi
