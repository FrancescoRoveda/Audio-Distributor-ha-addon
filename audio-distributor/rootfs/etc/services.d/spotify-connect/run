#!/usr/bin/with-contenv bashio
# ==============================================================================
# Audio Distributor - Spotify Connect Receiver (librespot)
# ==============================================================================

readonly LOG_PREFIX="[spotify-connect]"
readonly FIFO_PATH="/tmp/snapfifo_spotify"
readonly CACHE_DIR="/data/librespot"

log_info()    { bashio::log.info    "${LOG_PREFIX} $*"; }
log_debug()   { bashio::log.debug   "${LOG_PREFIX} $*"; }
log_warning() { bashio::log.warning "${LOG_PREFIX} $*"; }
log_error()   { bashio::log.error   "${LOG_PREFIX} $*"; }
log_notice()  { bashio::log.notice  "${LOG_PREFIX} $*"; }

dbus_ready() {
    dbus-send --system --print-reply \
        --dest=org.freedesktop.DBus \
        /org/freedesktop/DBus org.freedesktop.DBus.ListNames >/dev/null 2>&1
}

avahi_ready() {
    dbus-send --system --print-reply \
        --dest=org.freedesktop.Avahi \
        / org.freedesktop.Avahi.Server.GetState 2>/dev/null | grep -q 'int32 2'
}

log_info "Waiting for avahi-daemon..."
timeout=60
elapsed=0
while ! dbus_ready || ! avahi_ready; do
    sleep 1
    elapsed=$((elapsed + 1))
    if [ $elapsed -ge $timeout ]; then
        log_error "Timeout waiting for Avahi and D-Bus readiness after ${timeout}s"
        exit 1
    fi
done
log_info "Avahi and D-Bus ready (${elapsed}s)"

log_info "Waiting for snapcast-server FIFO..."
timeout=30
elapsed=0
while [ ! -p "${FIFO_PATH}" ]; do
    sleep 1
    elapsed=$((elapsed + 1))
    if [ $elapsed -ge $timeout ]; then
        log_warning "FIFO not created by snapcast-server, creating it now"
        mkfifo "${FIFO_PATH}"
        chmod 666 "${FIFO_PATH}"
        break
    fi
done
log_info "FIFO ready"

spotify_name=$(bashio::config 'spotify_name')
default_client_volume="78"
if bashio::config.has_value 'default_client_volume'; then
    default_client_volume="$(bashio::config 'default_client_volume')"
fi

mkdir -p "${CACHE_DIR}/cache" "${CACHE_DIR}/system"

verbosity=""
if bashio::config.equals 'log_level' 'debug' || bashio::config.equals 'log_level' 'trace'; then
    verbosity="--verbose"
    log_debug "Verbose librespot logging enabled"
fi

log_notice "=== Spotify Connect Receiver starting ==="
log_info "Device name: '${spotify_name}'"
log_info "Output: pipe to ${FIFO_PATH}"
log_info "Initial volume: ${default_client_volume}%"

exec librespot \
    --name "${spotify_name}" \
    --device-type speaker \
    --backend pipe \
    --device "${FIFO_PATH}" \
    --format S16 \
    --bitrate 320 \
    --cache "${CACHE_DIR}/cache" \
    --system-cache "${CACHE_DIR}/system" \
    --disable-audio-cache \
    --enable-volume-normalisation \
    --initial-volume "${default_client_volume}" \
    --autoplay on \
    ${verbosity}
